# Copier en .env.local et remplir. Ne jamais committer .env.local.
OPENAI_API_KEY=
# Modèle utilisé par les routes serveur (vérifier le nom exact dans la doc OpenAI).
OPENAI_MODEL=gpt-4.1-mini

# Supabase Auth + RLS. Leave empty for the local demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_MODE=1
# Server-only. Required only for complete account deletion; never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
